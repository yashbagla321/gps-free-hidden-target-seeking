<?xml version="1.0" ?>
<!-- GPS-free hidden-target world.
     The vehicle is a genuine differential-drive model with wheel joints:
     /odom comes from the DiffDrive system's wheel integration (physics,
     slip, inertia), NOT from ground truth. A separate OdometryPublisher
     provides the truth channel /gfs/truth_odom consumed ONLY by the relay
     emulator and the evaluator. An occluding wall stands between the start
     area and the target to make the hidden-target premise physical. -->
<sdf version="1.9">
  <world name="gfs_hidden_target">
    <physics name="default" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Occluder near the target region: conveys the hidden-target premise
         visually while leaving the mission corridor (x in [0, 1.5]) clear.
         The seeker is a greedy certified controller with NO obstacle
         avoidance (out of scope); the world supplies collision realism and
         the mission geometry is chosen collision-free, per the plan. -->
    <model name="occluder">
      <static>true</static>
      <pose>4.1 5.0 0.75 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>3.0 0.25 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>3.0 0.25 1.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.4 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Visual markers only: relay pole and target disc (no sensing). -->
    <model name="relay_marker">
      <static>true</static>
      <pose>-6.0 -1.5 0.5 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><cylinder><radius>0.08</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="target_marker">
      <static>true</static>
      <pose>1.5 9.0 0.02 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Differential-drive vehicle with real wheel joints. -->
    <model name="gfs_vehicle">
      <pose>0 0 0.12 0 0 0.4</pose>
      <link name="chassis">
        <inertial>
          <mass>8.0</mass>
          <inertia><ixx>0.12</ixx><iyy>0.20</iyy><izz>0.26</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.45 0.30 0.12</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.45 0.30 0.12</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient></material>
        </visual>
      </link>
      <link name="left_wheel">
        <pose relative_to="chassis">0 0.19 -0.02 -1.5707 0 0</pose>
        <inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
      </link>
      <link name="right_wheel">
        <pose relative_to="chassis">0 -0.19 -0.02 -1.5707 0 0</pose>
        <inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
      </link>
      <link name="caster">
        <pose relative_to="chassis">-0.18 0 -0.07 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz></inertia></inertial>
        <collision name="c">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="caster_joint" type="ball">
        <parent>chassis</parent><child>caster</child>
      </joint>

      <!-- Physics wheel odometry (estimator input). -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.38</wheel_separation>
        <wheel_radius>0.10</wheel_radius>
        <topic>/model/gfs_vehicle/cmd_vel</topic>
        <odom_topic>/model/gfs_vehicle/odometry</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
      <!-- Ground-truth channel (relay emulator + evaluator ONLY). -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/gfs/truth_odom</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
